# Optional LOCAL configuration. Copy to .env; never commit real credentials.
# The API does not auto-load this file. Use uvicorn --env-file .env explicitly.
# Relative paths below assume commands run from the repository root.
OSTEOPATCH_RUNTIME_ARTIFACTS=runtime-artifacts
# Set OSTEOPATCH_DB to a disposable working copy before testing review writes.
# OSTEOPATCH_DB=runtime-artifacts/work/review.sqlite3
# Optional, existing file only; no automatic download:
# OSTEOPATCH_IMAGE_ALLOWLIST=runtime-artifacts/demo-allowlist.json
# Enterprise identity is development-only. Do not expose the local issuer.
# OSTEOPATCH_ENT_DB=runtime-artifacts/work/enterprise.sqlite3
# Set a local signing key through your environment, not in tracked files.
