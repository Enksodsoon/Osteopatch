# Verified runtime artifacts are required separately, never public Git assets.
runtime-artifacts/

# Credentials and machine-local configuration; examples stay tracked.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
.mcp.json
.vscode/mcp.json

# Python / local tooling
**/.venv/
**/.webvenv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
*.py[cod]
.coverage
htmlcov/

# Node / Vite / browser outputs
**/node_modules/
**/dist/
**/.vite/
*.tsbuildinfo
**/test-results/
**/playwright-report/
**/e2e-results.json

# Databases and model binaries; curated existing evidence remains tracked.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite
*.db
*.pt
*.pth
*.onnx
*.safetensors

# Generated website and local QA tools
_site/
.tools/
.maintenance/
.worktrees/
.superpowers/

# Local logs, OS files and editor/agent scratch
*.log
*.log.err
.DS_Store
Thumbs.db
.freebuff/
