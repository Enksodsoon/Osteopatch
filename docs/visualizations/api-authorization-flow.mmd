flowchart TD
  req["Browser request<br/>signed sign-in credential + selected project"] --> access["Verify identity and credential expiry"]
  access --> permission["Check permission for requested action"]
  permission --> role{"Current role available?"}
  role -->|yes| scoped{"Does this role allow the requested action?"}
  role -->|missing| dbrole["Read current role from account database"]
  dbrole --> scoped
  scoped -->|no membership| hidden["Project not found"]
  scoped -->|wrong role| denied["Action not allowed"]
  scoped -->|allowed| proxy["Confirm image belongs to selected project"]
  proxy -->|absent or outside scope| notfound["Image not found or not in this project"]
  proxy -->|in project| backend["Call image review backend in this process"]
  title["Implemented local access checks for sign-in and project review"] -.-> access
